# Скопируй в .env и подставь свои значения.
# Supabase → Project Settings → API

# URL проекта, вида https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Публичный ключ anon. Он и должен быть в браузере: сам по себе он ничего
# не открывает, потому что все таблицы закрыты RLS.
VITE_SUPABASE_ANON_KEY=

# ВНИМАНИЕ: service_role ключ сюда класть НЕЛЬЗЯ. Всё, что начинается
# с VITE_, попадает в собранный сайт и видно любому. service_role обходит
# RLS — его место только в backend, в переменных окружения сервера.
